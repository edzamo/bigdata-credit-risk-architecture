# Copiar a .env y ajustar antes de levantar el compose.
# Nunca commitear el archivo .env real (ver .gitignore).

MINIO_ROOT_USER=bigdata_admin
MINIO_ROOT_PASSWORD=bigdata_password_change_me

POSTGRES_USER=bigdata_admin
POSTGRES_PASSWORD=bigdata_password_change_me
POSTGRES_DB=credit_risk

# Ajustar a la baja si la máquina tiene menos de 8 GB disponibles para Docker
SPARK_LOCAL_CORES=2
SPARK_DRIVER_MEMORY=2g

# Ruta (dentro del contenedor) al CSV de Home Credit Default Risk (application_train.csv,
# descargado de Kaggle) — debe existir en data/raw/ antes de "docker compose up".
CREDIT_CSV_PATH=/opt/app/data/raw/application_train.csv
